<?xml version="1.0" encoding="utf-8"?>
<!-- The mark of assets/brand/mark.svg (two sails over one hull, ink `#ececec`) on the adaptive icon's
     108 dp canvas: the mark's 64 unit box is centred and drawn 1 to 1, so it stays inside the 66 dp
     the launcher never crops. Also the themed icon's layer: the launcher keeps its shape only. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="22"
        android:translateY="22">
        <path
            android:fillColor="#ececec"
            android:pathData="M19,8L19,38L37,38Z"
            android:strokeColor="#ececec"
            android:strokeLineJoin="round"
            android:strokeWidth="4" />
        <path
            android:fillColor="#ececec"
            android:pathData="M44,19L44,38L57,38Z"
            android:strokeColor="#ececec"
            android:strokeLineJoin="round"
            android:strokeWidth="4" />
        <path
            android:pathData="M7,46C20,53.5 44,53.5 57,46"
            android:strokeColor="#ececec"
            android:strokeLineCap="round"
            android:strokeWidth="6.4" />
    </group>
</vector>

# Flottille's hub as a systemd service (docs/releases.md, "What CI publishes"). Put the binary of
# the archive at /usr/local/bin/flottille-hub and this file in /etc/systemd/system/, then:
#
#   systemctl daemon-reload && systemctl enable --now flottille-hub
#
# The first start makes the hub's key. Each device then pairs in pair mode, run beside the hub that
# runs, as root (the service's user is its own), which prints a code and its QR for one device:
#
#   sudo flottille-hub --state /var/lib/flottille-hub pair
#
# Its log: journalctl -u flottille-hub
#
# --public-url is the address the devices reach the hub at, through the proxy: the pair code holds
# it (a hub on the loopback has none of its own, and `pair` refuses to print a code without one).
# It listens on the loopback, for a reverse proxy on this host that holds the certificate and
# passes HTTP upgrades on (open 443 for the proxy, nothing for the hub). To reach it directly,
# give a certificate (--tls-cert, --tls-key) and another --listen address, and open its port.
[Unit]
Description=Flottille hub
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/flottille-hub --listen 127.0.0.1:7448 --public-url https://hub.example.net --state /var/lib/flottille-hub
# Its own user and its own state folder (/var/lib/flottille-hub), the key and the member list.
# DynamicUser already implies NoNewPrivileges, ProtectSystem=strict and a private /tmp.
DynamicUser=yes
StateDirectory=flottille-hub
StateDirectoryMode=0700
Restart=on-failure
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
